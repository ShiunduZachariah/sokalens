APP_ENV=local
APP_SECRET=local-dev-secret-change-me

API_PORT=8080
API_BIND_ADDRESS=127.0.0.1
PORT=8080
DATABASE_URL=postgres://sports:sports@localhost:5433/sports_prediction?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Container-network URLs. Percent-encode reserved characters in URI credentials.
DATABASE_URL_DOCKER=
REDIS_URL_DOCKER=
ACCA_DB_SCHEMA=public
ACCA_REDIS_NAMESPACE=acca
ACCA_REDIS_TTL_SECONDS=15
ACCA_INVENTORY_V2_ENABLED=false
ACCA_INVENTORY_READ_SOURCE=v2
OPENAPI_PATH=packages/contracts/openapi.yaml
# Docker-internal API URLs for web/admin containers.
PREDICTION_API_BASE_URL=http://api:8080
ADMIN_API_BASE_URL=http://api:8080
ADMIN_API_BEARER_TOKEN=
# Sentry error tracking DSNs (public client DSN is safe to expose in the bundle).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Ops controller (observe mode).
OPS_ENV=production
OPS_LOG_LEVEL=info
OPS_INCIDENT_STORE_ENABLED=false
OPS_ALERT_SIGNING_SECRET=

API_SERVICE_ENABLE_REAL_PROVIDER_CALLS=false
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
API_REQUEST_TIMEOUT=2750ms
AUTH_REQUEST_TIMEOUT=8s
PUBLIC_RESULT_DETAIL_HOURS=24
PREDICTION_RESULT_RAW_RETENTION_DAYS=2
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=65536
PUBLIC_WEB_URL=http://localhost:3000
GUEST_ANALYSIS_VIEW_LIMIT=4
GUEST_ANALYSIS_WINDOW=168h
USER_SESSION_TTL=720h
ADMIN_SESSION_TTL=30m
AUTH_TOKEN_TTL=30m
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
BILLING_MODE=disabled
BILLING_PROVIDER=sandbox
BILLING_WEBHOOK_SECRET=

WORKER_POLL_INTERVAL=10s
WORKER_QUEUE_CONCURRENCY=4
WORKER_DB_MAX_OPEN_CONNS=12
WORKER_DB_MAX_IDLE_CONNS=6
MOCK_API_FOOTBALL_URL=http://localhost:8090
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
ENABLE_REAL_API_FOOTBALL_CALLS=false
ENABLE_MOCK_API_FOOTBALL_CALLS=true
API_FOOTBALL_KEY=

# Batched in-play statistics poll (fixtures?ids= at 60s, 20 fixtures per
# request). OFF until a live capture confirms the provider's embedded
# statistics shape: a wrong assumption does not error, it decodes to zero
# teams, so the poll would spend quota, store nothing, and make every league
# look as though it has no corner or card data. Confirm with
# services/worker/cmd/capturefixtureids, account for the spend in the quota
# planner, then enable.
INPLAY_STATISTICS_POLL_ENABLED=false
FOOTBALL_PROVIDER=api-football
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4
ENABLE_REAL_FOOTBALL_DATA_ORG_CALLS=false
FOOTBALL_DATA_ORG_API_KEY=
# TheSportsDB (free tier, test key 123) -- second-tier reference provider for
# team/league logos and squad metadata only. The key lives in the URL path, not
# a header; ENABLE_REAL_THE_SPORTS_DB_CALLS gates real calls (default off).
THE_SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json/123/
THE_SPORTS_DB_API_KEY=123
ENABLE_REAL_THE_SPORTS_DB_CALLS=false
THE_SPORTS_DB_MAX_PER_CYCLE=20
PROVIDER_SCHEDULE_INTERVAL=4h
PREDICTION_SCHEDULE_INTERVAL=1m
RECOMMENDATION_SCHEDULE_INTERVAL=15m
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_CONCURRENCY=4
EMAIL_PROVIDER=log
# The launch delivery policy permits verification and password-reset email only.
# Production currently uses Resend; Cloudflare Email Routing handles inbound mail.
# Cloudflare Email Sending remains an optional future provider.
#
# EMAIL_FALLBACK_PROVIDERS is an ordered, comma-separated chain tried when the
# active provider demonstrably could not accept a message (refused connection,
# rejected credentials, 429, 5xx). Failures that might already have been
# accepted never fail over; they retry the same provider with the same
# idempotency key. "log" is rejected here because it reports every message as
# delivered, which would turn an outage into silent loss.
EMAIL_FALLBACK_PROVIDERS=
# Cloudflare Email Sending: set to true only after observing the account's API
# accept a "headers" object. Until then bulk email, which must carry an RFC 8058
# List-Unsubscribe header, is routed to a provider that can carry it.
CLOUDFLARE_EMAIL_SUPPORTS_HEADERS=false
EMAIL_FROM_ADDRESS=no-reply@sokalens.com
EMAIL_FROM_NAME=SokaLens
EMAIL_FROM_NOTIFICATIONS=notifications@sokalens.com
EMAIL_FROM_SUPPORT=support@sokalens.com
EMAIL_FROM_NOREPLY=no-reply@sokalens.com
EMAIL_TEST_TO=
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_ENCRYPTION=starttls
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@sokalens.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Legacy SMTP aliases remain supported during migration.
SMTP_ADDRESS=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
WORKER_HEARTBEAT_MAX_AGE=10m

# Optional JSON overlay for prediction-engine thresholds, weights, decay rates, and limits.
# Leave empty to use the architecture defaults validated at worker startup.
PREDICTION_ENGINE_CONFIG_JSON=

# The API-Football package, in requests per provider day. This is a hard
# ceiling: the worker refuses provider calls past it on its own count of
# requests sent, so a provider header advertising a larger package cannot
# raise it. Raising the plan means raising this.
PROVIDER_DAILY_LIMIT=7500
# 12% of the package, enough to cover live polling to midnight. Not 4000:
# that was 5% of the 75000 plan and is 53% of this one.
PROVIDER_DAILY_RESERVE=900
# Provider-confirmed, down from the 450 the Ultra plan allowed.
PROVIDER_MINUTE_LIMIT=300
PROVIDER_MINUTE_RESERVE=15

POSTGRES_DB=sports_prediction
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports
POSTGRES_LOCAL_PORT=5433
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
MOCK_API_FOOTBALL_PORT=8090
MOCK_API_FOOTBALL_BIND_ADDRESS=127.0.0.1
TYPESENSE_API_KEY=local-typesense-key
TYPESENSE_URL=http://typesense:8108
TYPESENSE_BIND_ADDRESS=127.0.0.1
TYPESENSE_PORT=8108
MAILHOG_BIND_ADDRESS=127.0.0.1
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=3001
UPTIME_BIND_ADDRESS=127.0.0.1
UPTIME_PORT=3002

# --- Telegram ops bridge (outbound long-poll only; no new listening port) ----
# Fails closed: with ENABLED=true, a missing token / chat id / allowlist keeps
# the poller down. Leave ENABLED=false until CHAT_ID and ALLOWED_USER_IDS are set.
OPS_TELEGRAM_ENABLED=false
OPS_TELEGRAM_BOT_TOKEN=
# Private group or DM the bot serves. Groups are negative numbers.
OPS_TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs. Empty means deny everything.
OPS_TELEGRAM_ALLOWED_USER_IDS=
OPS_TELEGRAM_POLL_TIMEOUT_SECONDS=30
OPS_TELEGRAM_SEND_RATE_PER_SEC=1
# Gates /run and /confirm independently of the rest of the bridge.
OPS_TELEGRAM_RUNBOOKS_ENABLED=false

# --- Ops bridge: GitHub issue filing (/issue) --------------------------------
# Optional. Without a token /issue reports filing unavailable and returns the
# assembled issue body as text so it can be pasted manually — never dropped.
# Needs a fine-grained PAT with Issues: read & write on this repo only.
OPS_GITHUB_TOKEN=
OPS_GITHUB_OWNER=ShiunduZachariah
OPS_GITHUB_REPO=sports-prediction-platform

# --- Ops bridge: notification email fallback ---------------------------------
# Telegram must never be the only delivery path. A Telegram outage during an
# incident would otherwise lose the notification entirely.
OPS_EMAIL_SMTP_ADDRESS=
OPS_EMAIL_SMTP_USERNAME=
OPS_EMAIL_SMTP_PASSWORD=
OPS_EMAIL_FROM_ADDRESS=
OPS_EMAIL_TO_ADDRESS=

# --- Ops bridge: runbooks (/run, /confirm) -----------------------------------
# Gates /run and /confirm independently of the rest of the bridge.
# Always-available operations: retry-job, check-backup (Postgres only).
OPS_RUNBOOK_SERVICES=sports-prediction-platform-worker-1,sports-prediction-platform-api-1
#
# SECURITY: OPS_DOCKER_ENABLED=true lets /run restart allowlisted containers.
# It requires mounting /var/run/docker.sock into ops-controller, which is
# ROOT-EQUIVALENT ON THE HOST: it widens the blast radius of a stolen bot token
# from "read ops data" to "control every container on the box". Leave it false
# unless you have decided that trade deliberately. Rollback is NOT available
# from this surface at all, by design — it runs from the host deploy path.
OPS_DOCKER_ENABLED=false
OPS_DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Ops bridge: /resources (host CPU, memory, disk) -------------------------
# Read from the observability stack in the compose network; a container can
# only see its own cgroup, not the host filesystem.
OPS_PROMETHEUS_URL=http://prometheus:9090

# Append-only minute-by-minute live match history (in-play architecture 5).
# Off by default: it adds a write per in-play fixture per poll, so switching it
# on is a deliberate act rather than something that arrives with a deploy.
# Partition maintenance runs regardless -- a partition that exists costs an
# empty table, one that does not is an insert failure the moment this is
# enabled, and that switch gets flipped before a fixture window far more often
# than during a quiet Tuesday.
ENABLE_FIXTURE_SNAPSHOTS=false
# Live event timeline writer (fixture_events). Off by default: enable it for a
# single live window first, then leave it on once events are landing.
ENABLE_FIXTURE_EVENTS=false
# Enforces the SEO fixture history gate: a fixture page is advertised in the
# sitemap only when both teams have at least four settled matches on record
# before kickoff.
#
# Read only by the seo sweep. The fixture PAGE applies the same bar to its own
# robots tag unconditionally, with no flag, so the two are only consistent when
# this is on. With it off the sweep still advertises the thin fixtures the page
# is serving as noindex -- a sitemap advertising a noindexed URL, which is the
# defect the seourl package exists to prevent and which the post-deploy
# search-index-audit fails the deploy on.
#
# Measured 2026-09-28 against a copy of production data: withholds 126 of 8,365
# indexable fixtures (1.5%), all long tail -- friendlies, third tiers, youth
# tournaments -- with 107 of them a single match below the bar and recovering on
# their own. It removes nothing from the index that the page was not already
# withholding; it only stops the sitemap disagreeing.
SEO_FIXTURE_HISTORY_GATE=true
# Adsterra publisher API token, for the reporting API (site id 6093931). It is
# a credential, not a zone key: the zone keys that render ads are public and
# live in ad_providers.public_config, while this one reads revenue and unit
# statistics for the whole account and must never reach the browser or the
# repository. Set it in the host env file on each environment; the value here
# is a placeholder.
#
# Nothing in this codebase calls that API yet. The name is declared so the
# value has one home when something does, rather than being discovered in a
# chat log a month later.
ADSTERRA_API_TOKEN=replace-me
