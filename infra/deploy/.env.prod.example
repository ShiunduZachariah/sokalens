# Production environment template — copy to infra/deploy/.env.prod and fill in
# real values. NEVER commit real secrets. All values here are placeholders.
#
# Placeholder convention: keep them low-entropy prose like `set-me-...`, never
# a token-shaped literal like REPLACE_WITH_64_HEX_CHARS. That form scores 3.70
# entropy and trips gitleaks' generic-api-key rule, so every file using it
# needs a .gitleaksignore fingerprint, and every NEW file that copies it fails
# secret-scan until someone adds another. Two of the entries in .gitleaksignore
# exist only for that reason. Say how to generate the value in a comment
# instead; the comment is not scanned.

APP_ENV=production
# Generate with: openssl rand -hex 32
APP_SECRET=set-me-see-comment-above

# Public domain (Cloudflare fronts sokalens.com).
NEXT_PUBLIC_SITE_URL=https://sokalens.com
NEXT_PUBLIC_ENABLE_API_SPORTS_WIDGETS=false

# PostgreSQL (source of truth). Production must use TLS.
POSTGRES_DB=sports_prediction
POSTGRES_USER=sports
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Postgres data dir must use an encrypted host volume (see runbook).
DATABASE_URL=postgres://sports:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sports_prediction?sslmode=verify-full
DATABASE_URL_DOCKER=postgres://sports:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sports_prediction?sslmode=verify-full

# Redis (cache/queue/lock only; rebuildable, never source of truth).
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/0
REDIS_URL_DOCKER=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/0

# API-Football (Ultra plan: 75,000 requests/day, 450 requests/minute). Key is a secret.
API_FOOTBALL_KEY=REPLACE_WITH_API_FOOTBALL_KEY
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
ENABLE_REAL_API_FOOTBALL_CALLS=true
FOOTBALL_PROVIDER=hybrid

# Batched in-play statistics poll (fixtures?ids= at 60s, 20 fixtures per
# request). OFF until a live capture confirms the provider's embedded
# statistics shape: a wrong assumption does not error, it decodes to zero
# teams, so the poll would spend quota, store nothing, and make every league
# look as though it has no corner or card data. Confirm with
# services/worker/cmd/capturefixtureids, account for the spend in the quota
# planner, then enable.
INPLAY_STATISTICS_POLL_ENABLED=false

# football-data.org (free score history + backfill).
FOOTBALL_DATA_ORG_API_KEY=REPLACE_WITH_FOOTBALL_DATA_ORG_KEY
ENABLE_REAL_FOOTBALL_DATA_ORG_CALLS=true

# TheSportsDB (free tier, test key 123) — second-tier reference provider used
# for logo/metadata backfill on canonical teams and leagues. The key lives in
# the URL path; ENABLE_REAL_THE_SPORTS_DB_CALLS gates real calls (default off).
THE_SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json/123/
THE_SPORTS_DB_API_KEY=123
ENABLE_REAL_THE_SPORTS_DB_CALLS=true
# Per-run cap on how many teams/leagues the daily logo backfill touches (1..100).
THE_SPORTS_DB_MAX_PER_CYCLE=20

# Provider quota governor (Pro plan, provider-confirmed: 7,500/day, 300/minute).
# The daily figure is a hard ceiling rather than a target -- the worker refuses
# past it on its own count of requests sent, see quota.DailyBudget.planLimit.
PROVIDER_DAILY_LIMIT=7500
PROVIDER_DAILY_RESERVE=900
PROVIDER_MINUTE_LIMIT=300
PROVIDER_MINUTE_RESERVE=15

# Quota planner tuning.
QUOTA_BACKFILL_MIN_SAFE_BUDGET=200
QUOTA_BACKFILL_MAX_PER_CYCLE=3
QUOTA_STATISTICS_BACKFILL_MAX_PER_CYCLE=0
QUOTA_BACKFILL_DAYS=30
# Hard per-day ceiling on discretionary backfill spend, in requests. Per-cycle
# caps bound a cycle and cannot bound a day: on 2026-09-21 a restart left 4,076
# backfill jobs queued and every per-cycle cap was respected.
QUOTA_BACKFILL_MAX_REQUESTS_PER_DAY=1200
# What the recurring schedule costs per day irrespective of the fixture
# calendar. The quota forecast omitted this and reported it as spendable
# surplus.
QUOTA_FIXED_DAILY_OVERHEAD=900
# 60s, not 30s: a full day of polling is 1,440 requests against 2,880.
QUOTA_LIVE_POLL_SECONDS=60
PREDICTION_SCHEDULE_INTERVAL=15m
# Two-switch retention rollout. First release remains false/true; candidate-only
# reporting is true/true; bounded deletion requires true/false after backup.
ENABLE_DESTRUCTIVE_RETENTION=false
# Independently enables the bounded hourly engine_predictions drain after a
# restore-verified backup and QA canary. Remains off on initial deployment.
ENABLE_RAW_PREDICTION_DRAIN=false
RAW_PREDICTION_DRAIN_BATCH_SIZE=1000
RAW_PREDICTION_DRAIN_MAX_BATCHES=10
# Append-only minute-by-minute live match history (in-play architecture 5).
# Off by default: it adds a write per in-play fixture per poll, so switching it
# on is a deliberate act rather than something that arrives with a deploy.
# Partition maintenance runs regardless -- a partition that exists costs an
# empty table, one that does not is an insert failure the moment this is
# enabled, and that switch gets flipped before a fixture window far more often
# than during a quiet Tuesday.
ENABLE_FIXTURE_SNAPSHOTS=false
# Live event timeline writer (fixture_events). Off by default: enable it for a
# single live window first, then leave it on once events are landing.
ENABLE_FIXTURE_EVENTS=false
RETENTION_DRY_RUN=true

# Worker job durability (retries per job, claim lease duration).
WORKER_JOB_MAX_ATTEMPTS=3
WORKER_JOB_LEASE_DURATION=15m

# Cross-worker provider request dedupe lease (blocks duplicate concurrent calls).
WORKER_REQUEST_DEDUPE_TTL=2m

# Prometheus text endpoint (bind localhost only; scraped via the prometheus profile).
WORKER_METRICS_ADDRESS=127.0.0.1:9091

# Verification and password-reset email only. Every other notification category
# is suppressed at the delivery worker during the initial launch.
# Resend sends transactional mail for now. Cloudflare Email Routing handles
# inbound public aliases; Cloudflare Email Sending remains an admin-selectable
# future provider once the account is enabled for paid sending.
EMAIL_PROVIDER=resend
# Ordered failover chain. Leave empty until a second provider is credentialed
# and verified; a fallback that is not actually configured is skipped, not an
# error, so this is safe to set ahead of the cutover.
EMAIL_FALLBACK_PROVIDERS=
# Cloudflare Email Sending: set to true only after observing the account's API
# accept a "headers" object. Until then bulk email, which must carry an RFC 8058
# List-Unsubscribe header, is routed to a provider that can carry it.
CLOUDFLARE_EMAIL_SUPPORTS_HEADERS=false
EMAIL_FROM_NAME=SokaLens
EMAIL_FROM_ADDRESS=no-reply@sokalens.com
EMAIL_FROM_NOTIFICATIONS=notifications@sokalens.com
EMAIL_FROM_SUPPORT=support@sokalens.com
EMAIL_FROM_NOREPLY=no-reply@sokalens.com
SMTP_ADDRESS=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_ENCRYPTION=starttls
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@sokalens.com
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_EMAIL_API_TOKEN=REPLACE_WITH_EMAIL_SENDING_EDIT_TOKEN

# Cloudflare Turnstile registration and login abuse protection. Create a managed widget
# restricted to sokalens.com and www.sokalens.com, then keep the secret only in
# the VPS .env.prod file.
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY

# Billing stays disabled until a real provider adapter + price IDs exist.
BILLING_PROVIDER=sandbox

# Typesense (search).
TYPESENSE_API_KEY=REPLACE_WITH_STRONG_KEY

# Ops controller (observe-only; autonomy modes stay disabled).
OPS_INCIDENT_STORE_ENABLED=false
OPS_DATABASE_URL=postgres://sports:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sports_prediction?sslmode=verify-full
# Generate with: openssl rand -hex 32
OPS_INCIDENT_SIGNING_SECRET=set-me-see-comment-above

# Observability (Grafana/Prometheus/Loki/Promtail; all bind 127.0.0.1 only).
# Grafana admin login — the real password lives in .env.prod, never in Git.
# Generate with: openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
GF_SERVER_ROOT_URL=http://localhost:3004

# Sentry is configured at the application layer (Next.js web/admin) — there is
# no Sentry service in this stack. The DSNs are read from the web/admin app env
# vars (see apps/web and apps/admin), not from this observability profile.

# --- Telegram ops bridge (outbound long-poll only; no new listening port) ----
# Fails closed: with ENABLED=true, a missing token / chat id / allowlist keeps
# the poller down. Leave ENABLED=false until CHAT_ID and ALLOWED_USER_IDS are set.
OPS_TELEGRAM_ENABLED=false
OPS_TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Private group or DM the bot serves. Groups are negative numbers.
OPS_TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs. Empty means deny everything.
OPS_TELEGRAM_ALLOWED_USER_IDS=
OPS_TELEGRAM_POLL_TIMEOUT_SECONDS=30
OPS_TELEGRAM_SEND_RATE_PER_SEC=1
# Gates /run and /confirm independently of the rest of the bridge.
OPS_TELEGRAM_RUNBOOKS_ENABLED=false
# Daily digest. On by default: its silence is the operator's only signal that
# the bridge itself has stopped, so it is opt-out rather than opt-in. The hour
# and minute are local to the operator zone (EAT in production).
OPS_TELEGRAM_DIGEST_ENABLED=true
OPS_TELEGRAM_DIGEST_HOUR=8
OPS_TELEGRAM_DIGEST_MINUTE=0

# --- Ops bridge: GitHub issue filing (/issue) --------------------------------
# Optional. Without a token /issue reports filing unavailable and returns the
# assembled issue body as text so it can be pasted manually — never dropped.
# Needs a fine-grained PAT with Issues: read & write on this repo only.
OPS_GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
OPS_GITHUB_OWNER=ShiunduZachariah
OPS_GITHUB_REPO=sports-prediction-platform

# --- Ops bridge: notification email fallback ---------------------------------
# Telegram must never be the only delivery path. A Telegram outage during an
# incident would otherwise lose the notification entirely.
OPS_EMAIL_SMTP_ADDRESS=
OPS_EMAIL_SMTP_USERNAME=
OPS_EMAIL_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
OPS_EMAIL_FROM_ADDRESS=
OPS_EMAIL_TO_ADDRESS=

# --- Ops bridge: runbooks (/run, /confirm) -----------------------------------
# Gates /run and /confirm independently of the rest of the bridge.
# Always-available operations: retry-job, check-backup (Postgres only).
OPS_RUNBOOK_SERVICES=sports-prediction-platform-worker-1,sports-prediction-platform-api-1
#
# SECURITY: OPS_DOCKER_ENABLED=true lets /run restart allowlisted containers.
# It requires mounting /var/run/docker.sock into ops-controller, which is
# ROOT-EQUIVALENT ON THE HOST: it widens the blast radius of a stolen bot token
# from "read ops data" to "control every container on the box". Leave it false
# unless you have decided that trade deliberately. Rollback is NOT available
# from this surface at all, by design — it runs from the host deploy path.
OPS_DOCKER_ENABLED=false
OPS_DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Ops bridge: /resources (host CPU, memory, disk) -------------------------
# Read from the observability stack in the compose network; a container can
# only see its own cgroup, not the host filesystem.
OPS_PROMETHEUS_URL=http://prometheus:9090

# --- Off-site database backups (docs/operations/offsite-backup-runbook.md) ---
# Any S3-compatible endpoint. Backblaze B2 is preferred over Cloudflare R2 for
# correlated failure, not price: Cloudflare already holds DNS, TLS, CDN and
# Turnstile, so backups there mean one account problem takes out production and
# the recovery path at the same moment.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_BUCKET=sokalens-backups
# REQUIRED for off-site upload. The dump contains account emails and password
# hashes, and the script refuses to upload plaintext without an explicit
# override. Store this in a password manager and one offline place -- a
# passphrase that exists only on this host makes the backup worthless the moment
# the host dies, which is exactly what it was created for.
BACKUP_ENCRYPTION_PASSPHRASE=

