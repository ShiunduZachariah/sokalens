# QA environment. Copy to .env.qa on the host and fill in the REPLACE_ values.
# Never reuse a production secret here: QA is reachable by more people and is
# deliberately the less careful environment.
#
# There are exactly two environments, production and QA. Before adding a third,
# read docs/operations/environments.md -- three abandoned ones were found on
# this host in September 2026, two of them still holding disk and memory.
#
# Host ports are NOT configured here. They are written literally in
# docker-compose.qa.yml so that a typo in this file cannot bind QA onto a
# production port. This file governs identity, data and provider access.

APP_ENV=qa

# Prefixes every container, volume, network and built image. Production runs as
# `sports-prediction-platform` under the root Docker daemon. QA runs rootless
# under its own user, so the two cannot see each other's objects at all -- this
# name is the second line of defence, not the first.
#
# It is `sokalens-dev`, not `sokalens-qa`, and that is deliberate. The project
# name is what prefixes the volumes; renaming it points the stack at freshly
# created, empty ones and silently discards the QA database. The public
# hostnames moved to qa.* on 2026-09-16; this did not. Do not "fix" it.
COMPOSE_PROJECT_NAME=sokalens-dev

# Must differ from production's. Used to sign sessions; sharing it would let a
# QA-issued session be presented to production.
#
# Generate with: openssl rand -hex 32
# The literal below is deliberately low-entropy prose rather than a
# REPLACE_WITH_64_HEX_CHARS-style token: that placeholder scores 3.70 entropy
# and trips gitleaks' generic-api-key rule, which is why .env.prod.example
# needs two .gitleaksignore fingerprints. Not worth inheriting.
APP_SECRET=set-me-see-comment-above

# --- Database -------------------------------------------------------------
# Deliberately NOT production's `sports_prediction` / `sports`. The live QA
# stack reused both until 2026-09-18, which meant a mistyped host was one typo
# away from authenticating against production with credentials that looked
# correct -- only the password differed.
#
# Postgres applies these at initdb only, but that does NOT mean an existing
# environment is stuck with the wrong names: `ALTER DATABASE ... RENAME TO` and
# `ALTER ROLE ... RENAME TO` rename both in place, with no volume recreation
# and no data loss. The live QA database was corrected that way on 2026-09-18.
#
# Its role was not, and the reason is worth knowing before you try: a session
# user cannot rename itself, and the bootstrap superuser is the only login role
# the image creates -- so renaming it needs a second superuser to run the ALTER
# from. Under scram-sha-256 the rename keeps the password working; under md5 it
# would not, because the hash is salted with the role name.
POSTGRES_DB=sports_prediction_qa
POSTGRES_USER=sokalens_qa
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

DATABASE_URL=postgres://sokalens_qa:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sports_prediction_qa?sslmode=disable
DATABASE_URL_DOCKER=postgres://sokalens_qa:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sports_prediction_qa?sslmode=disable
OPS_DATABASE_URL=postgres://sokalens_qa:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sports_prediction_qa?sslmode=disable

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/0
REDIS_URL_DOCKER=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/0

# --- Provider access: off -------------------------------------------------
# The single most expensive mistake available here. A QA worker on live
# credentials draws from the same API-Football daily quota production plans
# against, and the quota planner has no idea a second consumer exists.
ENABLE_REAL_API_FOOTBALL_CALLS=false

# Batched in-play statistics poll (fixtures?ids= at 60s, 20 fixtures per
# request). OFF until a live capture confirms the provider's embedded
# statistics shape: a wrong assumption does not error, it decodes to zero
# teams, so the poll would spend quota, store nothing, and make every league
# look as though it has no corner or card data. Confirm with
# services/worker/cmd/capturefixtureids, account for the spend in the quota
# planner, then enable.
INPLAY_STATISTICS_POLL_ENABLED=false
ENABLE_REAL_FOOTBALL_DATA_ORG_CALLS=false
ENABLE_REAL_THE_SPORTS_DB_CALLS=false
API_SERVICE_ENABLE_REAL_PROVIDER_CALLS=false
ENABLE_MOCK_API_FOOTBALL_CALLS=true
FOOTBALL_PROVIDER=mock

# --- Destructive operations: off -----------------------------------------
ENABLE_DESTRUCTIVE_RETENTION=false
ENABLE_RAW_PREDICTION_DRAIN=false
RAW_PREDICTION_DRAIN_BATCH_SIZE=1000
RAW_PREDICTION_DRAIN_MAX_BATCHES=10
RETENTION_DRY_RUN=true

# --- Public identity ------------------------------------------------------
PUBLIC_WEB_URL=https://qa.sokalens.com

# --- Email: never send from QA -------------------------------------------
# A real provider here would email real users from test data.
EMAIL_PROVIDER=smtp
SMTP_ADDRESS=mailhog:1025
EMAIL_FROM_ADDRESS=qa@qa.sokalens.com

BILLING_MODE=disabled

# --- Turnstile ------------------------------------------------------------
# Off so QA journeys can be driven end to end. Turnstile refuses tokens to
# headless browsers, so leaving it on makes automated signup/login untestable.
# The basic-auth gate in the Caddyfile is what keeps QA private.
TURNSTILE_REQUIRED=false

# QA must run the ACCA engine, because production does.
#
# This was unset until 2026-09-22, so QA inherited the compose default of
# false while production ran true -- meaning no ACCA change was ever exercised
# before it reached production. Two faults shipped that way on the same day: an
# endpoint answering 503 on roughly half of requests, and a generator timing
# out on the narrow filter corners.
#
# Turning it on is necessary but not sufficient. Composition draws legs from
# fixtures that have not kicked off, and QA's provider is a static mock, so the
# calendar never advances past whatever was last loaded. Run
# scripts/qa/seed-acca-inventory.sh to give it a week of upcoming fixtures.
ACCA_INVENTORY_V2_ENABLED=true
